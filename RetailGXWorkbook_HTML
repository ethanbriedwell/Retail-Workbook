<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Retail Guest Experience Performance Summary</title>
  <style>
    /* Brand font stack uses approved GillSans names first; browser falls back only if GillSans is unavailable on the device. */
    :root {
      --choctaw-red: #AB2328;
      --deep-red: #AB2328;
      --brand-brown: #4F2C1D;
      --burnt: #4F2C1D;
      --gold: #EBB000;
      --olive: #548235;
      --sage: #548235;
      --mustard: #EBB000;
      --blue: #1F4E79;
      --light-blue: #3C88CF;
      --black: #000000;
      --ink: #4F2C1D;
      --muted: rgba(79, 44, 29, 0.72);
      --paper: #f7f3ed;
      --line: rgba(171, 35, 40, 0.35);
      --card: rgba(255, 253, 247, 0.86);
      --good: #548235;
      --warn: #EBB000;
      --bad: #AB2328;
      --shadow: 0 18px 60px rgba(79, 44, 29, 0.14);
    }

    :root {
      --font-body: GillSans-Regular, "Gill Sans", "Gill Sans MT", Calibri, Arial, sans-serif;
      --font-semibold: GillSans-SemiBold, "Gill Sans", "Gill Sans MT", Calibri, Arial, sans-serif;
      --font-bold: GillSans-Bold, "Gill Sans", "Gill Sans MT", Calibri, Arial, sans-serif;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: var(--font-body);
      color: var(--ink);
      background:
        radial-gradient(circle at 15% 12%, rgba(171, 35, 40, 0.05), transparent 22%),
        radial-gradient(circle at 86% 22%, rgba(79, 44, 29, 0.07), transparent 28%),
        linear-gradient(135deg, #f8f5ef 0%, #eee6dd 100%);
      min-height: 100vh;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      opacity: 0.38;
      background-image:
        linear-gradient(70deg, transparent 0 30%, rgba(171,35,40,0.10) 30% 33%, transparent 33% 55%, rgba(79,44,29,0.10) 55% 58%, transparent 58%),
        repeating-radial-gradient(circle at 18% 20%, rgba(79, 44, 29, 0.08) 0 1px, transparent 1px 6px);
      mix-blend-mode: multiply;
      z-index: -2;
    }

    body::after {
      content: "";
      position: fixed;
      width: 760px;
      height: 760px;
      right: -120px;
      top: 120px;
      background: conic-gradient(from 220deg, transparent 0deg 44deg, rgba(171,35,40,0.08) 44deg 65deg, transparent 65deg 108deg, rgba(79, 44, 29, 0.09) 108deg 132deg, transparent 132deg 360deg);
      border-radius: 50%;
      transform: rotate(-18deg);
      pointer-events: none;
      z-index: -1;
    }

    .app {
      display: grid;
      grid-template-columns: minmax(820px, 1fr) 420px;
      gap: 22px;
      max-width: 1680px;
      margin: 0 auto;
      padding: 22px;
    }

    .report {
      position: relative;
      overflow: hidden;
      min-height: 960px;
      background: rgba(247, 243, 237, 0.94);
      border: 1px solid rgba(171, 35, 40, 0.16);
      border-radius: 28px;
      box-shadow: var(--shadow);
      padding: 32px 34px 26px;
    }

    .report::before {
      content: "";
      position: absolute;
      inset: 0;
      background:
        linear-gradient(90deg, transparent 0 35%, rgba(171,35,40,0.055) 35% 37%, transparent 37% 100%),
        radial-gradient(circle at 82% 15%, rgba(171,35,40,0.08), transparent 30%);
      pointer-events: none;
    }

    .report > * { position: relative; z-index: 1; }

    .topbar {
      display: grid;
      grid-template-columns: 132px 1fr;
      gap: 22px;
      align-items: start;
      margin-bottom: 22px;
    }

    .brand-badge {
      height: 126px;
      border-radius: 28px;
      background: linear-gradient(145deg, var(--choctaw-red), #4F2C1D);
      overflow: hidden;
      display: grid;
      place-items: center;
      box-shadow: inset 0 -12px 18px rgba(0,0,0,0.12);
      padding: 0;
    }

    .brand-badge img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    h1 {
      margin: 4px 0 20px;
      font-size: clamp(32px, 3vw, 54px);
      line-height: 0.92;
      letter-spacing: -0.045em;
      text-transform: uppercase;
      font-weight: 600;
    }

    .header-inputs {
      display: grid;
      grid-template-columns: 1.15fr 0.8fr 1fr;
      gap: 14px;
    }

    .header-field,
    .inline-box {
      border: 2px solid var(--choctaw-red);
      border-radius: 999px;
      min-height: 48px;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 7px 14px;
      background: rgba(255, 255, 255, 0.38);
    }

    .label {
      font-family: var(--font-semibold);
      color: var(--black);
      font-size: 13px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      font-weight: 600;
      white-space: nowrap;
    }

    select,
    input,
    textarea {
      width: 100%;
      border: 0;
      background: transparent;
      color: var(--ink);
      font: inherit;
      outline: none;
    }

    .region-pill {
      font-weight: inherit;
      color: var(--ink);
      text-transform: none;
    }

    .section-title {
      margin: 18px 0 18px;
      color: var(--choctaw-red);
      font-family: var(--font-bold);
      font-size: clamp(30px, 3.3vw, 48px);
      line-height: 0.98;
      letter-spacing: 0.015em;
      text-transform: uppercase;
      font-weight: 700;
    }

    .snapshot-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
      padding-bottom: 24px;
      border-bottom: 2px solid rgba(79, 44, 29, 0.58);
    }

    .kpi-card {
      min-height: 232px;
      border-radius: 26px;
      padding: 18px 18px 16px;
      background: var(--card);
      border: 1px solid rgba(171, 35, 40, 0.15);
      display: grid;
      grid-template-columns: 112px 1fr;
      gap: 16px;
      align-items: center;
      box-shadow: 0 12px 30px rgba(79, 44, 29, 0.07);
    }


    .kpi-card.status-positive {
      border-color: rgba(84, 130, 53, 0.62);
      background:
        linear-gradient(135deg, rgba(84, 130, 53, 0.18), rgba(255, 253, 247, 0.92) 54%),
        var(--card);
      box-shadow: 0 14px 34px rgba(84, 130, 53, 0.18);
    }

    .kpi-card.status-negative {
      border-color: rgba(171, 35, 40, 0.64);
      background:
        linear-gradient(135deg, rgba(171, 35, 40, 0.18), rgba(255, 253, 247, 0.92) 54%),
        var(--card);
      box-shadow: 0 14px 34px rgba(171, 35, 40, 0.18);
    }

    .kpi-card.status-positive .kpi-title,
    .kpi-card.status-positive .gauge span {
      color: var(--good);
    }

    .kpi-card.status-negative .kpi-title,
    .kpi-card.status-negative .gauge span {
      color: var(--bad);
    }

    .kpi-card.status-positive .gauge {
      outline: 4px solid rgba(84, 130, 53, 0.16);
    }

    .kpi-card.status-negative .gauge {
      outline: 4px solid rgba(171, 35, 40, 0.16);
    }

    .gauge {
      width: 112px;
      height: 112px;
      border-radius: 50%;
      background: conic-gradient(var(--good) 0deg 245deg, var(--warn) 245deg 330deg, var(--bad) 330deg 360deg);
      display: grid;
      place-items: center;
      position: relative;
    }

    .gauge::after {
      content: "";
      width: 86px;
      height: 86px;
      border-radius: 50%;
      background: var(--paper);
      position: absolute;
      inset: 13px;
      box-shadow: inset 0 0 0 1px rgba(0,0,0,0.05);
    }

    .gauge span {
      position: relative;
      z-index: 2;
      color: var(--burnt);
      font-size: 26px;
      font-weight: 600;
      letter-spacing: -0.04em;
    }

    .kpi-title {
      color: var(--black);
      font-family: var(--font-bold);
      font-size: 18px;
      line-height: 1.08;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      font-weight: 700;
      margin-bottom: 9px;
    }


    .kpi-card .kpi-title,
    .kpi-card.status-positive .kpi-title,
    .kpi-card.status-negative .kpi-title {
      color: #000000 !important;
    }

    .kpi-meta {
      display: grid;
      gap: 7px;
      font-size: 13px;
    }

    .meta-row {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      padding: 6px 0;
      border-bottom: 1px solid rgba(79, 44, 29, 0.13);
    }

    .meta-row b { font-weight: 600; }
    .pos { color: var(--good); }
    .mid { color: var(--warn); }
    .neg { color: var(--bad); }

    .middle-grid {
      display: grid;
      grid-template-columns: 1.22fr 0.78fr;
      min-height: 430px;
      border-bottom: 2px solid rgba(79, 44, 29, 0.58);
    }

    .drivers-panel {
      padding: 22px 24px 14px 8px;
      border-right: 2px solid rgba(79, 44, 29, 0.58);
    }

    .stores-panel {
      padding: 22px 0 14px 26px;
    }

    .panel-title {
      margin: 0 0 16px;
      color: var(--choctaw-red);
      font-family: var(--font-bold);
      font-size: clamp(28px, 2.7vw, 44px);
      line-height: 0.98;
      letter-spacing: 0.015em;
      text-transform: uppercase;
      font-weight: 700;
    }

    .chart-wrap {
      height: 305px;
      border-radius: 24px;
      background: rgba(255, 255, 255, 0.42);
      border: 1px solid rgba(171, 35, 40, 0.12);
      padding: 14px 12px 10px;
      position: relative;
      overflow: hidden;
    }

    .chart-legend {
      display: flex;
      flex-wrap: wrap;
      gap: 10px 14px;
      align-items: center;
      margin: 10px 0 0 8px;
      color: var(--burnt);
      font-size: 13px;
      font-weight: 600;
    }

    .legend-item { display: inline-flex; gap: 6px; align-items: center; }
    .swatch { width: 13px; height: 13px; display: inline-block; border-radius: 3px; }
    .sw-month { background: var(--sage); }
    .sw-last { background: var(--burnt); }
    .sw-ytd { background: var(--mustard); }
    .sw-watch { background: var(--choctaw-red); }

    .top-store-list {
      display: grid;
      gap: 12px;
      margin-top: 10px;
    }

    .store-row {
      display: grid;
      grid-template-columns: 34px 1fr auto;
      align-items: center;
      gap: 10px;
      padding: 12px;
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.46);
      border: 1px solid rgba(171, 35, 40, 0.12);
    }

    .rank {
      font-family: var(--font-semibold);
      width: 34px;
      height: 34px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background: var(--deep-red);
      color: #fff;
      font-weight: 600;
    }

    .store-name {
      font-family: var(--font-semibold); font-weight: 600; }
    .store-region { color: var(--muted); font-size: 12px; text-transform: uppercase; font-weight: 600; }
    .store-score {
      font-family: var(--font-semibold); color: var(--burnt); font-size: 22px; font-weight: 700; }

    .summary {
      padding-top: 16px;
    }

    .summary .section-title {
      margin: 0 0 12px;
    }

    .summary-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 22px;
    }

    .summary-card {
      border-radius: 22px;
      padding: 16px 18px;
      min-height: 122px;
      background: rgba(255,255,255,0.46);
      border: 1px solid rgba(171, 35, 40, 0.12);
    }

    .summary-card.full { grid-column: 1 / -1; }

    .summary-card h3 {
      font-family: var(--font-semibold);
      margin: 0 0 8px;
      color: var(--olive);
      text-transform: uppercase;
      letter-spacing: -0.015em;
      font-size: 22px;
      font-weight: 700;
    }

    .summary-card p {
      margin: 0;
      color: var(--burnt);
      font-size: 18px;
      line-height: 1.12;
      font-weight: 650;
    }

    .footer-mark {
      display: flex;
      justify-content: flex-end;
      align-items: center;
      margin-top: 14px;
    }

    .footer-mark img {
      width: min(320px, 100%);
      height: auto;
      display: block;
      object-fit: contain;
    }

    .control-panel {
      position: sticky;
      top: 18px;
      align-self: start;
      max-height: calc(100vh - 36px);
      overflow: auto;
      border-radius: 28px;
      background: rgba(255, 253, 247, 0.94);
      border: 1px solid rgba(171, 35, 40, 0.14);
      box-shadow: var(--shadow);
      padding: 20px;
    }

    .control-panel h2 {
      margin: 0 0 4px;
      font-family: var(--font-bold);
      font-size: 24px;
      letter-spacing: 0.01em;
      font-weight: 700;
    }

    .help-text {
      margin: 0 0 14px;
      color: var(--muted);
      line-height: 1.3;
      font-size: 13px;
    }

    .form-section {
      border-top: 1px solid rgba(171, 35, 40, 0.13);
      padding-top: 14px;
      margin-top: 14px;
    }

    .form-section h3 {
      font-family: var(--font-semibold);
      margin: 0 0 10px;
      color: var(--deep-red);
      font-size: 14px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-weight: 600;
    }

    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .input-card {
      border: 1px solid rgba(171, 35, 40, 0.14);
      border-radius: 16px;
      padding: 10px 10px 8px;
      background: rgba(248, 245, 239, 0.76);
    }

    .input-card.wide { grid-column: 1 / -1; }

    .input-card label {
      font-family: var(--font-semibold);
      display: block;
      color: var(--muted);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-weight: 700;
      margin-bottom: 5px;
    }

    .input-card input,
    .input-card select,
    .input-card textarea {
      min-height: 28px;
      font-weight: 600;
    }

    .driver-editor {
      display: grid;
      gap: 10px;
    }

    .driver-block {
      border: 1px solid rgba(171, 35, 40, 0.14);
      border-radius: 18px;
      background: rgba(248, 245, 239, 0.76);
      padding: 12px;
    }

    .driver-name {
      font-family: var(--font-semibold);
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      font-weight: 600;
      color: var(--deep-red);
      margin-bottom: 8px;
    }

    .driver-fields {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
    }

    .top-store-fields {
      display: grid;
      grid-template-columns: 1.4fr 0.9fr 0.7fr;
      gap: 8px;
    }

    .checkbox-row {
      display: flex;
      align-items: center;
      gap: 10px;
      color: var(--ink);
      font-weight: 700;
      line-height: 1.25;
    }

    .checkbox-row input {
      width: auto;
      min-height: auto;
      accent-color: var(--choctaw-red);
    }

    .mini-field label {
      font-family: var(--font-semibold);
      display: block;
      color: var(--muted);
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      font-weight: 700;
      margin-bottom: 3px;
    }

    .mini-field input,
    .mini-field select {
      background: rgba(255,255,255,0.62);
      border: 1px solid rgba(171, 35, 40, 0.13);
      border-radius: 10px;
      min-height: 34px;
      padding: 6px 8px;
      font-weight: 700;
    }

    .button-row {
      display: flex;
      flex-wrap: wrap;
      gap: 9px;
      margin-top: 12px;
    }

    button,
    .file-button {
      border: 0;
      border-radius: 999px;
      padding: 10px 14px;
      background: var(--deep-red);
      color: #fff;
      font-weight: 700;
      cursor: pointer;
      box-shadow: 0 8px 20px rgba(171,35,40,0.14);
    }

    button.secondary,
    .file-button.secondary {
      background: rgba(91, 93, 43, 0.12);
      color: var(--olive);
      box-shadow: none;
    }

    .file-button input { display: none; }

    textarea.notes {
      min-height: 72px;
      resize: vertical;
      background: rgba(255,255,255,0.62);
      border: 1px solid rgba(171, 35, 40, 0.13);
      border-radius: 14px;
      padding: 10px;
      font-weight: 650;
    }


    .brand-palette {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 6px;
      margin-top: 10px;
    }

    .brand-chip {
      height: 20px;
      border-radius: 999px;
      border: 1px solid rgba(79,44,29,0.16);
    }

    .micro-note {
      color: var(--muted);
      font-size: 12px;
      line-height: 1.32;
      margin: 8px 0 0;
    }

    @media (max-width: 1250px) {
      .app { grid-template-columns: 1fr; }
      .control-panel { position: relative; top: 0; max-height: none; }
    }

    @media (max-width: 900px) {
      .report { padding: 22px; }
      .topbar, .middle-grid, .summary-grid { grid-template-columns: 1fr; }
      .drivers-panel { border-right: 0; border-bottom: 2px solid rgba(79, 44, 29, 0.58); padding-right: 0; }
      .stores-panel { padding-left: 0; }
      .snapshot-grid, .header-inputs { grid-template-columns: 1fr; }
      .kpi-card { grid-template-columns: 1fr; justify-items: center; text-align: center; }
      .meta-row { text-align: left; }
    }

    @page { size: landscape; margin: 0.35in; }

    @media print {
      body { background: #fff; }
      body::before, body::after, .control-panel { display: none !important; }
      .app { display: block; padding: 0; max-width: none; }
      .report {
        box-shadow: none;
        border-radius: 0;
        border: 0;
        min-height: 0;
        padding: 18px 22px;
      }
      .snapshot-grid { gap: 14px; }
      .kpi-card { min-height: 190px; }
      .middle-grid { min-height: 330px; }
      .chart-wrap { height: 230px; }
      .section-title { font-size: 38px; }
      .panel-title { font-size: 34px; }
      h1 { font-size: 36px; }
    }
  </style>
</head>
<body>
  <main class="app">
    <section class="report" id="report">
      <div class="topbar">
        <div class="brand-badge" aria-label="Choctaw Travel Plaza logo">
          <img src="data:image/jpeg;base64," alt="Choctaw Travel Plaza logo" />
        </div>
        <div>
          <h1>Monthly Retail Guest Experience Performance Report</h1>
          <div class="header-inputs">
            <div class="header-field">
              <span class="label">Location:</span>
              <select id="locationSelect" aria-label="Location"></select>
            </div>
            <div class="header-field">
              <span class="label">Region:</span>
              <span class="region-pill" id="regionDisplay">Central</span>
            </div>
            <div class="header-field">
              <span class="label">Report Period:</span>
              <input id="periodInput" type="text" value="May FY26" aria-label="Report period" />
            </div>
          </div>
        </div>
      </div>

      <h2 class="section-title">Core Performance Snapshot</h2>
      <div class="snapshot-grid" id="snapshotGrid"></div>

      <div class="middle-grid">
        <div class="drivers-panel">
          <h2 class="panel-title">Drivers</h2>
          <div class="chart-wrap" id="driverChart" role="img" aria-label="Retail NPS driver chart"></div>
          <div class="chart-legend">
            <span class="legend-item"><span class="swatch sw-month"></span>Month</span>
            <span class="legend-item"><span class="swatch sw-last"></span>Last Month</span>
            <span class="legend-item"><span class="swatch sw-ytd"></span>YTD</span>
            <span class="legend-item"><span class="swatch sw-watch"></span>Watch Area</span>
          </div>
        </div>
        <div class="stores-panel">
          <h2 class="panel-title">Top Performing Stores</h2>
          <div class="top-store-list" id="topStores"></div>
        </div>
      </div>

      <section class="summary">
        <h2 class="section-title">Summary</h2>
        <div class="summary-grid">
          <article class="summary-card">
            <h3>Key Insights</h3>
            <p id="keyInsights"></p>
          </article>
          <article class="summary-card">
            <h3>Watch Area</h3>
            <p id="watchArea"></p>
          </article>
          <article class="summary-card full">
            <h3>Recommendation</h3>
            <p id="recommendation"></p>
          </article>
        </div>
        <div class="footer-mark">
          <img src="data:image/png;base64," alt="Choctaw Nation Operational Excellence logo" />
        </div>
      </section>
    </section>

    <aside class="control-panel" aria-label="Dashboard controls">
      <h2>Dashboard Data Form</h2>
      <p class="help-text">Update the selected location below. Charts, KPI cards, deltas, strongest driver, watch area, and recommendations refresh immediately.</p>
        <div class="brand-palette" aria-label="Approved brand color palette">
          <span class="brand-chip" style="background:#AB2328" title="#AB2328"></span>
          <span class="brand-chip" style="background:#4F2C1D" title="#4F2C1D"></span>
          <span class="brand-chip" style="background:#548235" title="#548235"></span>
          <span class="brand-chip" style="background:#EBB000" title="#EBB000"></span>
          <span class="brand-chip" style="background:#1F4E79" title="#1F4E79"></span>
          <span class="brand-chip" style="background:#3C88CF" title="#3C88CF"></span>
          <span class="brand-chip" style="background:#000000" title="#000000"></span>
        </div>


      <div class="form-section">
        <h3>Report Details</h3>
        <div class="form-grid">
          <div class="input-card wide">
            <label for="formLocation">Location</label>
            <select id="formLocation"></select>
          </div>
          <div class="input-card">
            <label>Region</label>
            <input id="formRegion" type="text" readonly />
          </div>
          <div class="input-card">
            <label for="formPeriod">Reporting Period</label>
            <input id="formPeriod" type="text" />
          </div>
          <div class="input-card wide">
            <label for="keyInsightsOverride">Optional Manual Key Insights</label>
            <textarea class="notes" id="keyInsightsOverride" placeholder="Leave blank to use auto-generated key insights."></textarea>
          </div>
          <div class="input-card wide">
            <label for="watchAreaOverride">Optional Manual Watch Area</label>
            <textarea class="notes" id="watchAreaOverride" placeholder="Leave blank to use auto-generated watch area."></textarea>
          </div>
          <div class="input-card wide">
            <label for="summaryOverride">Optional Manual Recommendation</label>
            <textarea class="notes" id="summaryOverride" placeholder="Leave blank to use auto-generated recommendation."></textarea>
          </div>
        </div>
      </div>

      <div class="form-section">
        <h3>Main KPI Measurements</h3>
        <div class="driver-editor" id="kpiEditor"></div>
      </div>

      <div class="form-section">
        <h3>Retail NPS Drivers</h3>
        <div class="driver-editor" id="driverEditor"></div>
      </div>

      <div class="form-section">
        <h3>Top Performing Stores</h3>
        <div class="input-card wide">
          <label class="checkbox-row">
            <input id="topStoresOverride" type="checkbox" />
            Manually edit Top Performing Stores
          </label>
          <p class="micro-note">Turn this on to override the auto-ranking. Leave it off to rank stores automatically by Retail NPS.</p>
        </div>
        <div class="driver-editor" id="topStoresEditor"></div>
      </div>

      <div class="form-section">
        <h3>Actions</h3>
        <div class="button-row">
          <button type="button" id="printBtn">Print or Save PDF</button>
          <button type="button" class="secondary" id="downloadBtn">Download Data</button>
          <label class="file-button secondary">Import Data<input id="importFile" type="file" accept="application/json,.json" /></label>
          <button type="button" class="secondary" id="resetBtn">Reset Demo Data</button>
        </div>
        <p class="micro-note">The file stores edits in this browser using local storage. Use Download Data before sharing the template with someone else.</p>
      </div>
    </aside>
  </main>

  <script>
    const locationRegions = [
      { location: "Durant East", region: "Central" },
      { location: "Durant West", region: "Central" },
      { location: "Grant", region: "South" },
      { location: "Garvin", region: "South" },
      { location: "Broken Bow", region: "South" },
      { location: "Idabel", region: "South" },
      { location: "Heavener", region: "North" },
      { location: "Poteau", region: "North" },
      { location: "Pocola", region: "North" },
      { location: "McAlester", region: "North" },
      { location: "Stringtown", region: "Central" },
      { location: "Atoka", region: "Central" },
      { location: "Wilburton", region: "North" },
      { location: "Antlers", region: "South" },
      { location: "Hugo", region: "South" },
      { location: "Stigler", region: "North" },
      { location: "Talihina", region: "North" },
      { location: "Mercantile", region: "South" }
    ];

    const metricDefinitions = [
      { key: "retailNps", label: "Retail NPS", max: 100, precision: 1, allowBlank: false },
      { key: "opwalk", label: "OpWalk", max: 100, precision: 1, allowBlank: false },
      { key: "clo", label: "Choctaw Language Utilization", max: 100, precision: 1, allowBlank: true }
    ];

    const driverDefinitions = [
      { key: "friendly", label: "Friendly" },
      { key: "efficient", label: "Efficient" },
      { key: "cleanliness", label: "Cleanliness" },
      { key: "restroom", label: "Restroom" },
      { key: "quality", label: "Quality of Food" }
    ];

    const storageKey = "retailGuestExperienceReportTemplateData_v1";
    let selectedLocation = "Durant East";
    let reportPeriod = "May FY26";
    let data = loadData();

    function seededNumber(seed, base, spread, decimal = 1) {
      const x = Math.sin(seed * 999) * 10000;
      const fraction = x - Math.floor(x);
      return Number((base + (fraction * spread) - (spread / 2)).toFixed(decimal));
    }

    function buildDemoData() {
      const result = {};
      locationRegions.forEach((item, index) => {
        const retailMonth = seededNumber(index + 1, 66, 18);
        const retailLast = seededNumber(index + 7, retailMonth - 1, 10);
        const opwalkMonth = seededNumber(index + 11, 83, 18);
        const drivers = {};
        driverDefinitions.forEach((driver, driverIndex) => {
          const month = seededNumber((index + 1) * (driverIndex + 3), 76, 20);
          const lastMonth = seededNumber((index + 4) * (driverIndex + 5), month - 0.8, 8);
          drivers[driver.key] = {
            month,
            lastMonth,
            ytd: Number(((month + lastMonth + seededNumber(index + driverIndex + 20, month, 8)) / 3).toFixed(1)),
            goal: driver.key === "restroom" ? 75 : 80
          };
        });

        result[item.location] = {
          retailNps: {
            month: retailMonth,
            lastMonth: retailLast,
            ytd: Number(((retailMonth + retailLast) / 2).toFixed(1)),
            goal: 66.1,
            fy25: seededNumber(index + 15, 61, 16)
          },
          opwalk: {
            month: opwalkMonth,
            lastMonth: seededNumber(index + 16, opwalkMonth - 1, 9),
            ytd: seededNumber(index + 17, 82, 12),
            goal: 85,
            fy25: seededNumber(index + 18, 80, 12)
          },
          clo: {
            month: "",
            lastMonth: "",
            ytd: "",
            goal: 75,
            fy25: ""
          },
          drivers,
          surveys: Math.round(seededNumber(index + 30, 38, 46, 0)),
          topStoresOverrideEnabled: false,
          topStores: [],
          keyInsightsOverride: "",
          watchAreaOverride: "",
          recommendationOverride: ""
        };
      });
      return result;
    }

    function loadData() {
      try {
        const stored = localStorage.getItem(storageKey);
        if (stored) return mergeWithDefaults(JSON.parse(stored));
      } catch (error) {
        console.warn("Stored dashboard data could not be loaded", error);
      }
      return buildDemoData();
    }

    function mergeWithDefaults(incoming) {
      const defaults = buildDemoData();
      const merged = { ...defaults };
      Object.keys(incoming || {}).forEach(location => {
        merged[location] = {
          ...defaults[location],
          ...incoming[location],
          clo: {
            ...(defaults[location]?.clo || {}),
            ...(incoming[location]?.clo || {}),
            goal: numberOrNull(incoming[location]?.clo?.goal) === null ? 75 : incoming[location].clo.goal
          },
          drivers: {
            ...(defaults[location]?.drivers || {}),
            ...(incoming[location]?.drivers || {})
          }
        };
      });
      return merged;
    }

    function saveData() {
      localStorage.setItem(storageKey, JSON.stringify(data));
    }

    function numberOrNull(value) {
      if (value === "" || value === null || value === undefined) return null;
      const parsed = Number(value);
      return Number.isFinite(parsed) ? parsed : null;
    }

    function fmt(value, precision = 1) {
      const num = numberOrNull(value);
      return num === null ? "Enter data" : num.toFixed(precision);
    }

    function fmtDelta(value) {
      const num = numberOrNull(value);
      if (num === null) return "Enter data";
      const sign = num > 0 ? "+" : "";
      return `${sign}${num.toFixed(1)}`;
    }

    function deltaClass(value) {
      const num = numberOrNull(value);
      if (num === null) return "mid";
      if (num >= 0) return "pos";
      if (num >= -2) return "mid";
      return "neg";
    }

    function safePercent(value, max = 100) {
      const num = numberOrNull(value);
      if (num === null) return 0;
      return Math.max(0, Math.min(100, (num / max) * 100));
    }

    function currentRecord() {
      if (!data[selectedLocation]) data[selectedLocation] = buildDemoData()[selectedLocation];
      return data[selectedLocation];
    }

    function getRegion(location) {
      return locationRegions.find(item => item.location === location)?.region || "";
    }

    function populateLocationSelects() {
      [document.getElementById("locationSelect"), document.getElementById("formLocation")].forEach(select => {
        select.innerHTML = locationRegions.map(item => `<option value="${item.location}">${item.location}</option>`).join("");
        select.value = selectedLocation;
      });
    }

    function createField(label, value, path, extra = "") {
      return `
        <div class="mini-field">
          <label>${label}</label>
          <input type="number" step="0.1" value="${value ?? ""}" data-path="${path}" ${extra} />
        </div>
      `;
    }

    function renderEditors() {
      const record = currentRecord();
      const kpiEditor = document.getElementById("kpiEditor");
      kpiEditor.innerHTML = metricDefinitions.map(metric => {
        const values = record[metric.key] || {};
        const goalValue = metric.key === "clo" && numberOrNull(values.goal) === null ? 75 : values.goal;
        return `
          <div class="driver-block">
            <div class="driver-name">${metric.label}</div>
            <div class="driver-fields">
              ${createField("Month", values.month, `${metric.key}.month`)}
              ${createField("Last", values.lastMonth, `${metric.key}.lastMonth`)}
              ${createField("YTD", values.ytd, `${metric.key}.ytd`)}
              ${createField("Goal", goalValue, `${metric.key}.goal`)}
            </div>
          </div>
        `;
      }).join("");

      const driverEditor = document.getElementById("driverEditor");
      driverEditor.innerHTML = driverDefinitions.map(driver => {
        const values = record.drivers[driver.key] || {};
        return `
          <div class="driver-block">
            <div class="driver-name">${driver.label}</div>
            <div class="driver-fields">
              ${createField("Month", values.month, `drivers.${driver.key}.month`)}
              ${createField("Last", values.lastMonth, `drivers.${driver.key}.lastMonth`)}
              ${createField("YTD", values.ytd, `drivers.${driver.key}.ytd`)}
              ${createField("Goal", values.goal, `drivers.${driver.key}.goal`)}
            </div>
          </div>
        `;
      }).join("");

      renderTopStoresEditor();

      document.querySelectorAll("[data-path]").forEach(input => {
        input.addEventListener("input", event => {
          const newValue = event.target.dataset.path === "clo.goal" && event.target.value === "" ? 75 : (event.target.value === "" ? "" : Number(event.target.value));
          setByPath(currentRecord(), event.target.dataset.path, newValue);
          saveData();
          renderReport();
        });
      });
    }

    function getAutoTopStores() {
      return locationRegions.map(item => {
        const record = data[item.location] || {};
        return {
          location: item.location,
          region: item.region,
          score: numberOrNull(record.retailNps?.month)
        };
      }).filter(item => item.score !== null)
        .sort((a, b) => b.score - a.score)
        .slice(0, 5);
    }

    function ensureManualTopStores(record) {
      if (!Array.isArray(record.topStores) || record.topStores.length === 0) {
        record.topStores = getAutoTopStores().map(item => ({
          location: item.location,
          region: item.region,
          score: item.score
        }));
      }
      while (record.topStores.length < 5) {
        record.topStores.push({ location: "", region: "", score: "" });
      }
      return record.topStores.slice(0, 5);
    }

    function renderTopStoresEditor() {
      const record = currentRecord();
      const override = document.getElementById("topStoresOverride");
      const editor = document.getElementById("topStoresEditor");
      if (!override || !editor) return;

      override.checked = !!record.topStoresOverrideEnabled;
      const rows = ensureManualTopStores(record);
      editor.innerHTML = rows.map((item, index) => `
        <div class="driver-block">
          <div class="driver-name">Rank ${index + 1}</div>
          <div class="top-store-fields">
            <div class="mini-field">
              <label>Store</label>
              <input type="text" value="${escapeHtml(item.location ?? "")}" data-top-store-index="${index}" data-top-store-field="location" />
            </div>
            <div class="mini-field">
              <label>Region</label>
              <select data-top-store-index="${index}" data-top-store-field="region">
                ${["", "South", "Central", "North"].map(region => `<option value="${region}" ${region === (item.region ?? "") ? "selected" : ""}>${region || "Select"}</option>`).join("")}
              </select>
            </div>
            <div class="mini-field">
              <label>Score</label>
              <input type="number" step="0.1" value="${item.score ?? ""}" data-top-store-index="${index}" data-top-store-field="score" />
            </div>
          </div>
        </div>
      `).join("");

      override.onchange = event => {
        currentRecord().topStoresOverrideEnabled = event.target.checked;
        ensureManualTopStores(currentRecord());
        saveData();
        renderReport();
      };

      editor.querySelectorAll("[data-top-store-index]").forEach(input => {
        input.addEventListener("input", event => {
          const index = Number(event.target.dataset.topStoreIndex);
          const field = event.target.dataset.topStoreField;
          ensureManualTopStores(currentRecord());
          currentRecord().topStores[index][field] = field === "score" && event.target.value !== "" ? Number(event.target.value) : event.target.value;
          currentRecord().topStoresOverrideEnabled = true;
          document.getElementById("topStoresOverride").checked = true;
          saveData();
          renderReport();
        });
        input.addEventListener("change", event => {
          const index = Number(event.target.dataset.topStoreIndex);
          const field = event.target.dataset.topStoreField;
          ensureManualTopStores(currentRecord());
          currentRecord().topStores[index][field] = field === "score" && event.target.value !== "" ? Number(event.target.value) : event.target.value;
          currentRecord().topStoresOverrideEnabled = true;
          document.getElementById("topStoresOverride").checked = true;
          saveData();
          renderReport();
        });
      });
    }

    function escapeHtml(value) {
      return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function setByPath(object, path, value) {
      const parts = path.split(".");
      let cursor = object;
      parts.slice(0, -1).forEach(part => {
        if (!cursor[part]) cursor[part] = {};
        cursor = cursor[part];
      });
      cursor[parts[parts.length - 1]] = value;
    }

    function renderSnapshot() {
      const record = currentRecord();
      const grid = document.getElementById("snapshotGrid");
      grid.innerHTML = metricDefinitions.map(metric => {
        const values = record[metric.key] || {};
        const month = numberOrNull(values.month);
        const goal = metric.key === "clo" && numberOrNull(values.goal) === null ? 75 : numberOrNull(values.goal);
        const lastMonth = numberOrNull(values.lastMonth);
        const deltaGoal = month !== null && goal !== null ? month - goal : null;
        const shift = month !== null && lastMonth !== null ? month - lastMonth : null;
        const pct = safePercent(month, metric.max);
        let cardStatus = "";
        if (metric.key === "retailNps" && shift !== null) {
          cardStatus = shift >= 0 ? "status-positive" : "status-negative";
        }
        if (metric.key === "clo" && month !== null) {
          cardStatus = month > 75 ? "status-positive" : "status-negative";
        }
        const gradient = `conic-gradient(var(--good) 0deg 245deg, var(--warn) 245deg 330deg, var(--bad) 330deg 360deg)`;
        return `
          <article class="kpi-card ${cardStatus}">
            <div class="gauge" style="background:${gradient}"><span>${month === null ? "--" : fmt(month, metric.precision)}</span></div>
            <div>
              <div class="kpi-title">${metric.label}</div>
              <div class="kpi-meta">
                <div class="meta-row"><span>Goal</span><b>${fmt(goal)}</b></div>
                <div class="meta-row"><span>Delta to Goal</span><b class="${deltaClass(deltaGoal)}">${fmtDelta(deltaGoal)}</b></div>
                <div class="meta-row"><span>Delta Shift</span><b class="${deltaClass(shift)}">${fmtDelta(shift)}</b></div>
                <div class="meta-row"><span>YTD Average</span><b>${fmt(values.ytd)}</b></div>
              </div>
            </div>
          </article>
        `;
      }).join("");
    }

    function getDriverStats() {
      const record = currentRecord();
      return driverDefinitions.map(driver => {
        const values = record.drivers[driver.key] || {};
        const month = numberOrNull(values.month);
        const lastMonth = numberOrNull(values.lastMonth);
        const ytd = numberOrNull(values.ytd);
        const goal = numberOrNull(values.goal);
        return {
          ...driver,
          month,
          lastMonth,
          ytd,
          goal,
          deltaGoal: month !== null && goal !== null ? month - goal : null,
          shift: month !== null && lastMonth !== null ? month - lastMonth : null
        };
      });
    }

    function renderDriverChart() {
      const stats = getDriverStats();
      const validValues = stats.flatMap(item => [item.month, item.lastMonth, item.ytd]).filter(value => value !== null);
      const maxValue = Math.max(100, ...validValues, 1);
      const minDelta = Math.min(...stats.map(item => item.deltaGoal ?? 999));
      const watch = stats.find(item => item.deltaGoal === minDelta) || stats[0];
      const chart = document.getElementById("driverChart");

      const groupSpacing = 158;
      const startX = 66;
      const barWidth = 20;
      const barGap = 18;
      const chartBaseY = 214;
      const maxBarHeight = 174;

      const groups = stats.map((item, groupIndex) => {
        const bars = [
          { key: "month", label: "Month", value: item.month, className: item.key === watch.key ? "watch" : "month" },
          { key: "lastMonth", label: "Last", value: item.lastMonth, className: "last" },
          { key: "ytd", label: "YTD", value: item.ytd, className: "ytd" }
        ];

        const groupStart = startX + groupIndex * groupSpacing;
        const barHtml = bars.map((bar, barIndex) => {
          const h = bar.value === null ? 0 : Math.max(4, (bar.value / maxValue) * maxBarHeight);
          const x = groupStart + barIndex * (barWidth + barGap);
          const y = chartBaseY - h;
          const labelYOffset = barIndex === 1 ? 20 : 8;
          const fill = bar.className === "watch" ? "var(--choctaw-red)" : bar.className === "month" ? "var(--sage)" : bar.className === "last" ? "var(--burnt)" : "var(--mustard)";
          return `<rect x="${x}" y="${y}" width="${barWidth}" height="${h}" rx="5" fill="${fill}"></rect><text x="${x + (barWidth / 2)}" y="${Math.max(18, y - labelYOffset)}" text-anchor="middle" class="bar-value">${bar.value === null ? "" : bar.value.toFixed(1)}</text>`;
        }).join("");

        const shiftLabel = item.shift === null ? "" : `${item.shift >= 0 ? "+" : ""}${item.shift.toFixed(1)}`;
        const shiftClass = item.shift === null ? "" : item.shift >= 0 ? "up" : "down";
        const xCenter = groupStart + barWidth + barGap + 1;

        return `
          <g>
            ${barHtml}
            <text x="${xCenter}" y="240" text-anchor="middle" class="axis-label">${item.label.replace("Quality of Food", "Quality")}</text>
            <text x="${xCenter}" y="262" text-anchor="middle" class="inflection ${shiftClass}">${shiftLabel}</text>
          </g>
        `;
      }).join("");

      chart.innerHTML = `
        <svg viewBox="0 0 840 282" width="100%" height="100%" preserveAspectRatio="xMidYMid meet">
          <style>
            .grid-line { stroke: rgba(94, 67, 51, 0.15); stroke-width: 1; }
            .axis-label { font: 600 13px GillSans-SemiBold, "Gill Sans", Arial; fill: #4F2C1D; }
            .bar-value { font: 600 12px GillSans-SemiBold, "Gill Sans", Arial; fill: #4F2C1D; }
            .inflection { font: 600 13px GillSans-SemiBold, "Gill Sans", Arial; }
            .inflection.up { fill: var(--good); }
            .inflection.down { fill: var(--bad); }
          </style>
          <line x1="34" y1="214" x2="804" y2="214" class="grid-line"></line>
          <line x1="34" y1="154" x2="804" y2="154" class="grid-line"></line>
          <line x1="34" y1="94" x2="804" y2="94" class="grid-line"></line>
          ${groups}
        </svg>
      `;
    }

    function renderTopStores() {
      const record = currentRecord();
      const manualRows = Array.isArray(record.topStores)
        ? record.topStores
            .map(item => ({
              location: item.location || "",
              region: item.region || "",
              score: numberOrNull(item.score)
            }))
            .filter(item => item.location || item.region || item.score !== null)
            .slice(0, 5)
        : [];

      const top = record.topStoresOverrideEnabled && manualRows.length ? manualRows : getAutoTopStores();

      document.getElementById("topStores").innerHTML = top.map((item, index) => `
        <div class="store-row">
          <div class="rank">${index + 1}</div>
          <div><div class="store-name">${escapeHtml(item.location || "Enter store")}</div><div class="store-region">${escapeHtml(item.region || "Region")}</div></div>
          <div class="store-score">${item.score === null ? "--" : item.score.toFixed(1)}</div>
        </div>
      `).join("");
    }

    function renderInsights() {
      const record = currentRecord();
      const retail = record.retailNps || {};
      const retailMonth = numberOrNull(retail.month);
      const retailGoal = numberOrNull(retail.goal);
      const retailShift = retailMonth !== null && numberOrNull(retail.lastMonth) !== null ? retailMonth - numberOrNull(retail.lastMonth) : null;
      const stats = getDriverStats();
      const strongest = stats.filter(item => item.month !== null).sort((a, b) => b.month - a.month)[0];
      const watch = stats.filter(item => item.deltaGoal !== null).sort((a, b) => a.deltaGoal - b.deltaGoal)[0];
      const biggestGain = stats.filter(item => item.shift !== null).sort((a, b) => b.shift - a.shift)[0];
      const biggestDip = stats.filter(item => item.shift !== null).sort((a, b) => a.shift - b.shift)[0];

      let insight = "Enter current month, last month, YTD, and goal values to generate performance insights.";
      if (retailMonth !== null && strongest) {
        const goalText = retailGoal === null ? "goal status is pending" : `${fmtDelta(retailMonth - retailGoal)} to goal`;
        const shiftText = retailShift === null ? "shift is pending" : `${fmtDelta(retailShift)} from last month`;
        insight = `Retail NPS is ${fmt(retailMonth)} with ${goalText}; monthly movement is ${shiftText}. Strongest driver is ${strongest.label} at ${fmt(strongest.month)}${biggestGain ? `, with the largest positive inflection in ${biggestGain.label} at ${fmtDelta(biggestGain.shift)}.` : "."}`;
      }

      let watchText = "Add driver goals to identify the watch area.";
      if (watch) {
        const dipText = biggestDip && biggestDip.shift < 0 ? ` The sharpest monthly decline is ${biggestDip.label} at ${fmtDelta(biggestDip.shift)}.` : "";
        watchText = `${watch.label} is the primary watch area at ${fmtDelta(watch.deltaGoal)} to goal.${dipText}`;
      }

      if (record.keyInsightsOverride && record.keyInsightsOverride.trim()) insight = record.keyInsightsOverride.trim();
      if (record.watchAreaOverride && record.watchAreaOverride.trim()) watchText = record.watchAreaOverride.trim();

      let recommendation = "Use the data form to enter monthly scores, then prioritize the lowest driver against goal.";
      if (watch) {
        recommendation = `Focus the next action plan on ${watch.label}. Review associate behaviors tied to that driver, confirm the standard during shift huddles, and complete a targeted OpWalk follow-up before the next report-out.`;
      }
      if (record.recommendationOverride && record.recommendationOverride.trim()) recommendation = record.recommendationOverride.trim();

      document.getElementById("keyInsights").textContent = insight;
      document.getElementById("watchArea").textContent = watchText;
      document.getElementById("recommendation").textContent = recommendation;
    }

    function renderReport() {
      const record = currentRecord();
      document.getElementById("locationSelect").value = selectedLocation;
      document.getElementById("formLocation").value = selectedLocation;
      document.getElementById("regionDisplay").textContent = getRegion(selectedLocation);
      document.getElementById("formRegion").value = getRegion(selectedLocation);
      document.getElementById("periodInput").value = reportPeriod;
      document.getElementById("formPeriod").value = reportPeriod;
      document.getElementById("keyInsightsOverride").value = record.keyInsightsOverride || "";
      document.getElementById("watchAreaOverride").value = record.watchAreaOverride || "";
      document.getElementById("summaryOverride").value = record.recommendationOverride || "";
      renderSnapshot();
      renderDriverChart();
      renderTopStores();
      renderInsights();
    }

    function syncLocation(location) {
      selectedLocation = location;
      populateLocationSelects();
      renderEditors();
      renderReport();
    }

    function wireEvents() {
      document.getElementById("locationSelect").addEventListener("change", event => syncLocation(event.target.value));
      document.getElementById("formLocation").addEventListener("change", event => syncLocation(event.target.value));
      document.getElementById("periodInput").addEventListener("input", event => {
        reportPeriod = event.target.value;
        document.getElementById("formPeriod").value = reportPeriod;
      });
      document.getElementById("formPeriod").addEventListener("input", event => {
        reportPeriod = event.target.value;
        document.getElementById("periodInput").value = reportPeriod;
      });
      document.getElementById("keyInsightsOverride").addEventListener("input", event => {
        currentRecord().keyInsightsOverride = event.target.value;
        saveData();
        renderInsights();
      });
      document.getElementById("watchAreaOverride").addEventListener("input", event => {
        currentRecord().watchAreaOverride = event.target.value;
        saveData();
        renderInsights();
      });
      document.getElementById("summaryOverride").addEventListener("input", event => {
        currentRecord().recommendationOverride = event.target.value;
        saveData();
        renderInsights();
      });
      document.getElementById("printBtn").addEventListener("click", () => window.print());
      document.getElementById("resetBtn").addEventListener("click", () => {
        if (confirm("Reset demo data and clear local edits?")) {
          data = buildDemoData();
          saveData();
          renderEditors();
          renderReport();
        }
      });
      document.getElementById("downloadBtn").addEventListener("click", () => {
        const payload = { reportPeriod, selectedLocation, data };
        const blob = new Blob([JSON.stringify(payload, null, 2)], { type: "application/json" });
        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.href = url;
        link.download = "retail_guest_experience_dashboard_data.json";
        document.body.appendChild(link);
        link.click();
        link.remove();
        URL.revokeObjectURL(url);
      });
      document.getElementById("importFile").addEventListener("change", event => {
        const file = event.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = () => {
          try {
            const payload = JSON.parse(reader.result);
            data = mergeWithDefaults(payload.data || payload);
            reportPeriod = payload.reportPeriod || reportPeriod;
            selectedLocation = payload.selectedLocation && data[payload.selectedLocation] ? payload.selectedLocation : selectedLocation;
            saveData();
            populateLocationSelects();
            renderEditors();
            renderReport();
          } catch (error) {
            alert("The selected JSON file could not be imported.");
          }
        };
        reader.readAsText(file);
      });
    }

    populateLocationSelects();
    wireEvents();
    renderEditors();
    renderReport();
  </script>
</body>
</html>
